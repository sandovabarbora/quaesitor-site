/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Cloudflare served these as bare `text/html`, with no charset, and nosniff
# stops a browser correcting that by inspection — so it fell back to a legacy
# single-byte encoding and every em-dash and curly quote arrived as mojibake.
# The documents now declare utf-8 themselves; this states it at the transport
# layer too, where it outranks the meta tag.
#
# `/` needs its own rule: the root request path is `/`, not `/index.html`, so a
# rule written only for `*.html` never matches the page most people land on.
/
  Content-Type: text/html; charset=utf-8

/*.html
  Content-Type: text/html; charset=utf-8
